---
from context import current_user_id
---
<section class="login-page">
    <h1>Login</h1>

    {$if current_user_id.get()}
        <div class="status-banner status-in">
            <div>
                <strong>You're already logged in</strong>
                <div class="status-sub">user id: <code>{current_user_id.get()}</code></div>
            </div>
            <form method="POST" action="/logout" class="logout-form">
                <button class="logout-btn" type="submit">Log out</button>
            </form>
        </div>
    {$else}
        {$if query.get('error') == 'invalid'}
            <p class="form-error">Incorrect email or password.</p>
        {/if}
        {$if query.get('error') == 'no_db'}
            <p class="form-error">Database is not configured (DATABASE_URL missing) — cannot log in right now.</p>
        {/if}

        <!--
            Plain HTML form, no @submit binding. PyWire's client only
            intercepts events on elements carrying a data-on-<event>
            attribute (which @submit would add) — an unbound <form> submits
            natively, giving SessionMiddleware a real HTTP response to
            attach an httponly Set-Cookie to. See login_middleware.py.
        -->
        <form method="POST" action="/login" class="login-form">
            <label>Email
                <input type="email" name="email" required autocomplete="username" autofocus>
            </label>
            <label>Password
                <input type="password" name="password" required autocomplete="current-password">
            </label>
            <button type="submit">Log in</button>
        </form>
    {/if}
</section>

<style scoped>
.login-page {
    max-width: 420px;
    margin: 0 auto;
}

.status-banner {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.25rem;
    border-radius: 8px;
    margin-bottom: 1.5rem;
    border: 1.5px solid #28a860;
    background: var(--pico-card-background-color, #f4fbf6);
}

.status-sub {
    color: var(--pico-muted-color, #666);
    font-size: 0.85rem;
    margin-top: 0.15rem;
}

.logout-form {
    margin-left: auto;
}

.logout-btn {
    width: auto;
    padding: 0.5rem 1rem;
    font-size: 0.875rem;
    background: transparent;
    border: 1.5px solid #b82040;
    color: #b82040;
}

.form-error {
    background: #fdecee;
    border: 1.5px solid #b82040;
    color: #b82040;
    padding: 0.6rem 0.9rem;
    border-radius: 6px;
    font-size: 0.9rem;
}

.login-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
}
</style>
